# ---------- Core ----------
# Postgres. On Vercel use Neon's POOLED connection string (…-pooler…/db?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glowie_dev"
# Postgres used by `npm test` (never point this at production).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glowie_test"
# Public base URL, used for metadata, Stripe redirects, share/party links and the OpenRouter referer.
# Must be the public https URL in production: video models fetch the first frame from it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Brand domain (TBD) shown in share-card watermarks and used for email addresses. Defaults to glowie.app.
NEXT_PUBLIC_APP_DOMAIN="glowie.app"
# HMAC key for signed photo URLs. Generate with: openssl rand -base64 32 (required in production).
SIGNING_SECRET=""

# ---------- Auth (Clerk) ----------
# Clerk publishable key (enable Google, Apple, email magic link AND phone numbers with SMS verification; the free trial needs a verified phone).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Clerk secret key.
CLERK_SECRET_KEY=""
# Path of the sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# Path of the sign-up page.
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS="you@example.com"

# ---------- Payments (Stripe) ----------
# Stripe secret key (sk_test_… locally).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint /api/stripe/webhook (whsec_…; `stripe listen` prints one locally).
STRIPE_WEBHOOK_SECRET=""
# Optional: publishable key, only needed if you add client-side Stripe elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------- AI (OpenRouter) ----------
# OpenRouter API key. All model calls go through this one prepaid key.
OPENROUTER_API_KEY=""
# Email an alert when the OpenRouter balance drops below this many USD.
OPENROUTER_ALERT_THRESHOLD_USD="20"
# Global circuit breaker: block all AI calls once today's provider spend reaches this many USD.
DAILY_SPEND_CAP_USD="50"

# ---------- Storage ----------
# Vercel Blob read/write token (create a PRIVATE Blob store).
BLOB_READ_WRITE_TOKEN=""

# ---------- Rate limiting (Upstash Redis, required in production) ----------
# Upstash Redis REST URL.
UPSTASH_REDIS_REST_URL=""
# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Bot protection (Cloudflare Turnstile) ----------
# Turnstile site key, shown on the free-trial step.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Turnstile secret key (required in production for the free trial).
TURNSTILE_SECRET_KEY=""

# ---------- Email (Resend) ----------
# Resend API key. Without it, emails are logged and skipped.
RESEND_API_KEY=""
# From address for emails (domain must be verified in Resend).
EMAIL_FROM="Glowie <hello@glowie.app>"
# Where low-balance alerts are sent.
ALERT_EMAIL="you@example.com"

# ---------- Cron ----------
# Bearer token Vercel Cron sends to /api/cron/daily (Vercel sets the header automatically when CRON_SECRET is defined).
CRON_SECRET=""

# ---------- Analytics & errors ----------
# PostHog project key (loaded only after cookie consent).
NEXT_PUBLIC_POSTHOG_KEY=""
# PostHog host.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Sentry DSN. Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: Sentry source-map upload (only used if you add withSentryConfig to next.config.ts).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---------- Growth ----------
# Amazon Associates tag appended to Amazon shop links (e.g. glowie-20).
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=""

# ---------- Weather (Event mode) ----------
# Optional: Open-Meteo API key. The free API is for non-commercial use only; set a paid key for production traffic.
OPEN_METEO_API_KEY=""
