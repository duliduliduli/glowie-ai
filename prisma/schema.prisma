generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String
  createdAt        DateTime  @default(now())
  ageConfirmedAt   DateTime?
  trialUsedAt      DateTime?
  freePreviews     Int       @default(0) // trial + Glowup Party voter bonus
  referralCode     String    @unique
  referredById     String?
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("Referrals")
  stripeCustomerId String?   @unique
  // Fraud controls: set by charge.dispute.created.
  frozenAt         DateTime?
  purchasesBlocked Boolean   @default(false)
  autoTopUpPackId  String?
  autoTopUpBelow   Int?
  lastAutoTopUpAt  DateTime?
  deleteOriginalsImmediately Boolean @default(false)

  ledger   LedgerEntry[]
  holds    CreditHold[]
  photos   Photo[]
  sessions StyleSession[]
  aiCalls  AiCall[]
  parties  Party[]
  roasts   Roast[]
  links    ShareLink[]
  pending  PendingCheckout[]
}

enum LedgerType {
  purchase
  usage
  refund
  referral
  admin_adjust
}

// Append-only. Balance = SUM(amount). Never UPDATE or DELETE rows (except account deletion cascade).
model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           LedgerType
  amount         Int // credits, signed
  usdCents       Int? // money received, for purchases
  idempotencyKey String     @unique
  note           String?
  createdAt      DateTime   @default(now())

  @@index([userId])
}

enum HoldStatus {
  active
  settled
  released
}

model CreditHold {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  status    HoldStatus @default(active)
  reason    String
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  @@index([userId, status])
}

model StripeEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

// One row per "device:<hash>" and "phone:<hash>". A trial needs both keys unused.
model TrialClaim {
  key        String   @id
  userId     String
  createdAt  DateTime @default(now())
}

enum PhotoKind {
  selfie
  fullbody
  generated
  outfit
  video
}

model Photo {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PhotoKind
  fromCamera Boolean   @default(false)
  blobPath   String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([userId])
  @@index([createdAt])
}

model StyleSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  selfieId    String
  fullBodyId  String?
  vibe        String
  customPrompt String?
  quiz        Json
  analysis    Json?
  extra       Json? // event mode: weather, dress code, packing list
  status      String    @default("pending") // pending | analyzing | ready | failed
  free        Boolean   @default(false) // paid for by the free trial
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  looks       Look[]

  @@index([userId, createdAt])
}

model Look {
  id         String       @id @default(cuid())
  sessionId  String
  session    StyleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index      Int
  data       Json
  previewId  String?
  favorite   Boolean      @default(false)
  hairStatus String? // regret simulator: generating | ready | failed
  hairStages Json? // [{ label, photoId }]
  videoStatus String? // generating | ready | failed
  videoId    String?
  updatedAt  DateTime     @default(now()) @updatedAt
  createdAt  DateTime     @default(now())

  @@unique([sessionId, index])
}

model AiCall {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  model        String?
  status       String // ok | failed
  costUsd      Float    @default(0)
  credits      Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model ModelPrice {
  model           String   @id
  promptUsd       Float // per token
  completionUsd   Float
  imageInputUsd   Float    @default(0)
  imageOutputUsd  Float    @default(0)
  updatedAt       DateTime @updatedAt
}

// Glowup Party: friends vote between two looks without an account.
model Party {
  id        String      @id @default(cuid())
  token     String      @unique
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookAId   String
  lookBId   String
  createdAt DateTime    @default(now())
  revokedAt DateTime?
  votes     PartyVote[]
}

model PartyVote {
  id        String   @id @default(cuid())
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  choice    Int // 0 = look A, 1 = look B
  voterHash String
  createdAt DateTime @default(now())

  @@unique([partyId, voterHash])
}

// Public, revocable links: stylist handoff cards and roast cards.
model ShareLink {
  token     String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // stylist | roast
  refId     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([kind, refId])
}

model Roast {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  result    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A Stripe Checkout the user opened but hasn't paid yet. Counts toward the new-account caps so
// opening several checkouts in parallel can't get around them. Removed on completion or expiry.
model PendingCheckout {
  id        String   @id // Stripe session id (a temporary id until Stripe answers)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usdCents  Int
  createdAt DateTime @default(now())

  @@index([userId])
}
